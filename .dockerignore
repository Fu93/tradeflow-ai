# Docker build context exclusions.
#
# Runtime assets and selected operator tools are copied explicitly. Exclude
# local state and private key material from those directories too.

# ---- Secrets (never in an image) ----
.env
.env.*
!.env.example
.env.tmp
*.pem
*.key
**/*.pem
**/*.key
*.p8
*.p12
**/*.p8
**/*.p12
approval_keypair*.json
**/approval_keypair*.json

# ---- VCS / tooling ----
.git
.gitignore
.github
.pytest_cache
__pycache__
*/__pycache__
*.py[cod]
.venv
venv

# ---- Runtime state (regenerated locally, never shipped) ----
# SQLite writes sidecars as `-wal` / `-shm` and `-journal`; `data/sessions_json/`
# holds per-session snapshots.
data/sessions.db
data/sessions.db-wal
data/sessions.db-shm
data/sessions.db-journal
data/sessions_json/
# Desk databases, journals, backups and anchors are deployment state too.
*.db
*.db-*
**/*.db
**/*.db-*
**/*.db.*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
data/backups/
data/anchors/

# ---- Demo build intermediates ----
results/_frames/
results/pitch_preview/

# ---- Local scratch / documentation noise ----
_s4.py
*.log
