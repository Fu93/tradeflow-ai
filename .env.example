# 複製成 .env 並填入真值；.env 永不進 git（.gitignore 已擋）
# ---- Evolus ----
EVOLUS_API_KEY=__FILL_ME__
EVOLUS_APP_ID=__FILL_ME__

# ---- AMD tokenfactory（hackathon 官方 LLM 端點，已實測可用）----
# base URL 為 https://developer.amd.com.cn/radeon/api（注意是 .com.cn，不是 .com）
# 驗證指令：
#   curl -H "Authorization: Bearer $KEY" https://developer.amd.com.cn/radeon/api/v1/models
# 需帶 /v1 後綴；程式內部會再串接 /chat/completions
VLLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
VLLM_API_KEY=__FILL_ME__
# 實測 12 個模型；分類任務建議用 Flash 系列（27B/DeepSeek 延遲高達 17-58 秒）
VLLM_MODEL=Qwen3.8-Flash-Next
