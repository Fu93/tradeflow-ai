# ---- Secrets (never commit) ----
.env
.env.*
!.env.example
.env.tmp

# ---- Python ----
__pycache__/
*.pyc
.venv/
.pytest_cache/
.coverage
.coverage.*

# ---- Runtime state (regenerated locally, never shared) ----
# SQLite in WAL mode names its sidecars `<db>-wal` / `<db>-shm`, i.e. the suffix
# is `-wal`, NOT `.wal`. The earlier `*.wal` / `*.shm` patterns never matched,
# so `data/sessions.db-wal` and `-shm` were committed by accident.
*.db
*.db-wal
*.db-shm
*.db-journal
*.wal
*.shm
data/sessions_json/

# ---- Demo build intermediates ----
results/_frames/
results/pitch_preview/

# Comtrade preview cache (TTL sqlite). Regenerated. Not a source of figures.
.cache/

# ---- Scratch / local debug ----
_s4.py

# NOTE: `data/benchmark_ood_500.json` is intentionally TRACKED — it is imported
# at module load by `src/benchmark/ood_500_dataset.py`, which
# `tests/test_ood_500_benchmark.py` depends on. Ignoring it made the test suite
# fail to collect on a fresh clone. Regenerate with `scripts/generate_ood_500.py`.
#
# NOTE: `results/*.png` and `results/*.json` are intentionally TRACKED — they are
# the measured evidence cited by README / PITCH / LIMITATIONS (bench.json,
# real_llm_benchmark_100.json, real_stress_test_log.json, the figures). Regenerate
# with `python -m src.cli --figures` and the scripts in `scripts/`.

# AMD evidence files are produced on the machine that ran the script.
# They are not committed from a CPU/CI run: a skip or a CPU timing must not
# be checked in as if it were an AMD result. Force-add only after you have
# read the JSON and confirmed ran_on_amd_gpu / status matches what happened.
results/amd_endpoint_evidence.json
results/amd_gpu_benchmark.json

# ---- Scratch / local debug (continued) ----
# Root-level one-off repro scripts from the audit rounds; kept locally, not shared.
_dbg_*.py
_sweep_control.py
_verify_findings.py
.freebuff/

# Audit working files: back up a session DB before destructive checks, and the
# raw screenshots/logs the evidence scripts print. All regenerable, none needed
# to reproduce a finding (the scripts in debug_findings/ regenerate them).
debug_findings/_sessions_backup/
debug_findings/**/*.log
debug_findings/**/*.png
docs/internal/debug_findings/_sessions_backup/
docs/internal/debug_findings/**/*.log
docs/internal/debug_findings/**/*.png

# Human-confirmed span exports (scripts/export_confirmed_spans.py):
# real supplier correspondence, never committed. Export, train, delete.
confirmed_spans.jsonl
confirmed_spans.*.jsonl
