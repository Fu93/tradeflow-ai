# New installations only. Never overwrite an existing deployment's chain keys.
# Copy to .env, fill the required values, and keep .env private.
TRADEFLOW_ENV=production
TRADEFLOW_LEGACY=0
TRADEFLOW_API_KEY=__FILL_ME__
TRADEFLOW_CHAIN_KEY=__FILL_ME__
TRADEFLOW_CHAIN_KEY_ID=primary
TRADEFLOW_REQUIRE_SIGNED_APPROVAL=1
# Public half only. The private key stays on the approver's computer.
TRADEFLOW_APPROVAL_PUBKEY=__FILL_ME__

# Docker Compose paths. On Render replace these with the actual disk mount.
TRADEFLOW_DESK_DB=/app/data/desk.db
TRADEFLOW_DB_PATH=/app/data/sessions.db
TRADEFLOW_STORE_DIR=/app/data/sessions_json
TRADEFLOW_CHAIN_ANCHOR=/app/data/chain-anchor.json

# Start with manual intake and no external transmission or paid requests.
DESK_SMTP_SEND=0
TRADEFLOW_LLM_DAILY_CALLS=0
TRADEFLOW_WEB_EVIDENCE_OFFLINE=1
TRADEFLOW_MARKET_OFFLINE=1
TRADEFLOW_SOLVER_BACKEND=numpy

# Optional IMAP intake. Set all three; TLS certificate validation stays on.
# IMAP_HOST=
# IMAP_USERNAME=
# IMAP_PASSWORD=
# IMAP_PORT=993
# IMAP_SSL=1

# Optional Gmail intake. GMAIL_DRAFTS controls draft creation, not reading.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# Enable only after testing with a dedicated recipient.
# SMTP_HOST=
# SMTP_PORT=465
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# DESK_SMTP_SEND=1

# Optional model/search. Choose a budget before enabling paid calls.
# TRADEFLOW_LLM_API_KEY=
# TRADEFLOW_LLM_DAILY_CALLS=40
# TAVILY_API_KEY=
# TRADEFLOW_WEB_EVIDENCE_OFFLINE=0
