{
  "manifest_version": 3,
  "name": "TradeFlow Copilot — Procurement Decision Deck",
  "version": "5.1.0",
  "minimum_chrome_version": "114",
  "description": "Enterprise procurement decision copilot with calibrated Bayesian inference, terms TCO shadow cost analysis, and human-in-the-loop approval gates.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.1688.com/*",
    "*://*.alibaba.com/*",
    "*://*.globalsources.com/*",
    "*://*.made-in-china.com/*",
    "*://web.whatsapp.com/*",
    "*://wx.qq.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.1688.com/*",
        "*://*.alibaba.com/*",
        "*://*.globalsources.com/*",
        "*://*.made-in-china.com/*",
        "*://web.whatsapp.com/*",
        "*://wx.qq.com/*",
        "file:///*mock_chat.html*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open TradeFlow Copilot Deck"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:8000 http://127.0.0.1:8000;"
  }
}
