{
  "manifest_version": 3,
  "name": "TradeFlow Copilot — Procurement Decision Deck",
  "version": "5.2.0",
  "minimum_chrome_version": "114",
  "description": "Reads the supplier message on your screen, sends it to your TradeFlow desk, lets you confirm the price, and gives you the counter to copy. It never types or sends a message.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.1688.com/*",
    "*://*.alibaba.com/*",
    "*://*.globalsources.com/*",
    "*://*.made-in-china.com/*",
    "*://web.whatsapp.com/*",
    "*://wx.qq.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://tradeflow-ai-demo.onrender.com/*",
    "*://wx2.qq.com/*",
    "*://web.wechat.com/*",
    "*://web2.wechat.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.1688.com/*",
        "*://*.alibaba.com/*",
        "*://*.globalsources.com/*",
        "*://*.made-in-china.com/*",
        "*://web.whatsapp.com/*",
        "*://wx.qq.com/*",
        "file:///*mock_chat.html*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "*://wx2.qq.com/*",
        "*://web.wechat.com/*",
        "*://web2.wechat.com/*"
      ],
      "js": [
        "desk_import.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open TradeFlow Copilot Deck",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "import-latest": {
      "suggested_key": {
        "default": "Alt+Shift+I"
      },
      "description": "Import the visible supplier message into the live desk"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:8000 http://127.0.0.1:8000 https://tradeflow-ai-demo.onrender.com;"
  }
}
